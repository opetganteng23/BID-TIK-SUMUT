# Salin file ini menjadi .env.local lalu isi nilainya.
# Jangan pernah commit .env.local. Di Vercel, isi lewat Project Settings > Environment Variables.

# ---- Aplikasi ----
# URL publik situs (tanpa slash akhir). Dipakai untuk canonical, sitemap, cek Origin.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- MongoDB Atlas ----
# Gunakan user database khusus dengan hak minimal.
MONGODB_URI=
MONGODB_DB=bid_tik_sumut

# ---- Auth ----
# Rahasia penandatangan JWT sesi admin. Minimal 32 karakter acak.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=
# Rahasia terpisah untuk sesi pelapor pengaduan (jangan sama dengan AUTH_SECRET).
COMPLAINT_SESSION_SECRET=
# Rahasia HMAC untuk hash kode akses pengaduan.
COMPLAINT_ACCESS_PEPPER=

# ---- Super Admin awal (dipakai skrip seed saja) ----
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
# Minimal 12 karakter. Akun wajib ganti password saat login pertama.
SEED_ADMIN_PASSWORD=

# ---- Email (SMTP Gmail + App Password) ----
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USER=
MAIL_APP_PASSWORD=
MAIL_FROM_NAME=BID TIK Polda Sumut

# ---- Vercel Blob (media publik) ----
BLOB_READ_WRITE_TOKEN=

# ---- Pengaduan: storage privat lampiran ----
# Isi "true" hanya bila storage privat dan scanner sudah siap. Default nonaktif.
COMPLAINT_UPLOAD_ENABLED=false

# ---- Cron (auto-close pengaduan) ----
# Rahasia untuk memverifikasi pemanggilan endpoint cron.
CRON_SECRET=

# ---- Opsional: Cloudflare Turnstile ----
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
